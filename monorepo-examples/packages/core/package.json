{
  "name": "@asciidoc-prosemirror/core",
  "version": "2.0.0",
  "description": "Core AsciiDoc parser and serializer for ProseMirror",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "prosemirror",
    "asciidoc",
    "parser",
    "serializer",
    "markdown"
  ],
  "author": "Alexey Shcherbakov <akaguny@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/asciidoc-prosemirror.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "asciidoctor": "^3.0.4"
  },
  "peerDependencies": {
    "prosemirror-model": "^1.25.3"
  },
  "devDependencies": {
    "prosemirror-model": "^1.25.3",
    "prosemirror-test-builder": "^1.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
